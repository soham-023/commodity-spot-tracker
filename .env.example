# Copy to .env (git-ignored) and fill in what you have. Everything here is optional.

# data.gov.in API key for APMC mandi prices (https://data.gov.in -> Generate API key)
DATA_GOV_API_KEY=

# Telegram alerts: create a bot with @BotFather, then add it to a chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic JSON webhook (Slack/Discord-compatible "text" field)
ALERT_WEBHOOK_URL=

# Tuning
SPOT_SPREAD_THRESHOLD_PCT=5
SPOT_DAY_MOVE_PCT=3
SPOT_INGEST_CRON=0 30 18 * * *
